# Copia este archivo como .env y rellena tus datos.
# PostgreSQL local o gratis en la nube (Neon, Supabase):
DATABASE_URL=postgresql://usuario:password@localhost:5432/almacen

# Clave para firmar la cookie de sesión. Genera la tuya con:
#   openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-secreta
