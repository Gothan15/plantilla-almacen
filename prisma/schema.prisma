// Plantilla de almacén e inventario.
// La idea: copiar esta plantilla para cualquier negocio que necesite
// controlar existencias (almacén, tienda, taller, depósito...) y
// ajustar los modelos al caso concreto.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  ALMACENERO
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  TRASPASO
}

enum TipoOrden {
  COMPRA
  VENTA
}

enum EstadoOrden {
  BORRADOR
  CONFIRMADA
  CANCELADA
}

model User {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String // hash con bcrypt, nunca texto plano
  rol       Rol      @default(ALMACENERO)
  creadoEn  DateTime @default(now())

  movimientos Movimiento[]
  ordenes     Orden[]
}

// Un local físico: el almacén principal, una sucursal, un depósito.
// Cada producto vive en UN almacén; para mover mercancía entre
// locales se usan traspasos (quedan dos asientos en el libro).
model Almacen {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  activo      Boolean    @default(true)
  creadoEn    DateTime   @default(now())

  productos Producto[]
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
}

model Proveedor {
  id       Int        @id @default(autoincrement())
  nombre   String
  contacto String?
  telefono String?
  email    String?
  notas    String?
  creadoEn DateTime   @default(now())

  productos   Producto[]
  movimientos Movimiento[]
  ordenes     Orden[]
}

// El registro principal del almacén. `existencia` es la foto actual;
// el historial completo vive en Movimiento (el libro de registro).
// Desde la v2 el SKU y el código de barras son únicos POR ALMACÉN:
// el mismo producto puede existir en dos locales como dos fichas.
model Producto {
  id          Int      @id @default(autoincrement())
  almacenId   Int
  almacen     Almacen  @relation(fields: [almacenId], references: [id])
  sku         String // código interno, ej. ALM-001
  codigoBarras String? // EAN/UPC de fábrica, para el escáner
  foto        String? // foto como data URL (JPEG reducido); en producción, un almacén de objetos
  nombre      String
  descripcion String?
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])
  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  unidad      String   @default("u") // u, kg, L, caja, saco...
  precioCosto Decimal  @default(0) @db.Decimal(12, 2)
  precioVenta Decimal  @default(0) @db.Decimal(12, 2)
  existencia  Int      @default(0)
  stockMinimo Int      @default(0) // por debajo de esto salta la alerta
  ubicacion   String? // pasillo/estante, ej. "A-3"
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  movimientos Movimiento[]
  lineasOrden OrdenLinea[]

  @@unique([almacenId, sku])
  @@unique([almacenId, codigoBarras])
  @@index([nombre])
  @@index([categoriaId])
  @@index([almacenId])
}

// Libro de movimientos: cada entrada, salida o ajuste queda firmado
// por el usuario que lo hizo, con el saldo que quedó después.
// `cantidad` va con signo: + entradas, − salidas, ajuste = diferencia.
model Movimiento {
  id              Int            @id @default(autoincrement()) // = folio
  tipo            TipoMovimiento
  productoId      Int
  producto        Producto       @relation(fields: [productoId], references: [id])
  cantidad        Int
  saldoResultante Int
  motivo          String?
  proveedorId     Int?
  proveedor       Proveedor?     @relation(fields: [proveedorId], references: [id])
  ordenId         Int?
  orden           Orden?         @relation(fields: [ordenId], references: [id])
  usuarioId       Int
  usuario         User           @relation(fields: [usuarioId], references: [id])
  creadoEn        DateTime       @default(now())

  @@index([productoId, creadoEn])
  @@index([creadoEn])
}

// Órdenes de compra (a proveedores) y de venta (a clientes). Nacen en
// BORRADOR sin tocar el stock; al CONFIRMAR se aplica cada línea como
// movimiento del libro (entrada en compras, salida en ventas) y la
// orden queda cerrada. Cancelar solo se puede en borrador.
model Orden {
  id           Int         @id @default(autoincrement()) // = número de orden
  tipo         TipoOrden
  estado       EstadoOrden @default(BORRADOR)
  proveedorId  Int?
  proveedor    Proveedor?  @relation(fields: [proveedorId], references: [id])
  cliente      String? // solo ventas: nombre libre del cliente
  notas        String?
  usuarioId    Int
  usuario      User        @relation(fields: [usuarioId], references: [id])
  creadoEn     DateTime    @default(now())
  confirmadaEn DateTime?

  lineas      OrdenLinea[]
  movimientos Movimiento[]

  @@index([tipo, estado])
  @@index([creadoEn])
}

model OrdenLinea {
  id          Int     @id @default(autoincrement())
  ordenId     Int
  orden       Orden   @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int
  precio      Decimal @db.Decimal(12, 2) // costo en compras, venta en ventas

  @@index([ordenId])
}
